{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  commitBody: 'Signed-off-by: Pyrra renovatebot <renoavte@pyrra.dev>',
  extends: [
    'config:recommended',
    'github>prometheus-community/helm-charts//renovate.json',
  ],
  packageRules: [
    {
      description: 'helm-docs carries two CalVer tags from 2019 that outrank the current v1 line numerically, so only accept the v-prefixed semver tags.',
      matchPackageNames: ['norwoodj/helm-docs'],
      allowedVersions: '/^v\\d+\\.\\d+\\.\\d+$/',
    },
    {
      description: 'The prometheus-community/helm-charts preset disables every package outside charts/ and .github/workflows/, so re-enable the pre-commit hooks.',
      matchFileNames: ['.pre-commit-config.yaml'],
      enabled: true,
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
    },
    {
      matchPackageNames: ['helm/helm', 'helm/chart-testing'],
      automerge: true,
    },
    {
      matchPackageNames: ['kindest/node'],
      separateMultipleMinor: true,
    },
    {
      matchPackageNames: ['kindest/node'],
      matchUpdateTypes: ['major', 'minor'],
      enabled: false,
    },
    {
      matchPackageNames: ['kindest/node'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
  ],
}
